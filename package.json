{
  "name": "gtmgrid",
  "version": "0.9.6",
  "private": true,
  "type": "module",
  "description": "Local-first programmable GTM spreadsheet. Columns are functions.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "tsx packages/cli/src/index.ts",
    "mcp": "tsx packages/mcp/src/index.ts",
    "server": "tsx packages/server/src/index.ts",
    "desktop": "pnpm --filter @gtmgrid/desktop dev",
    "sidecar:build": "node packages/desktop/scripts/bundle-sidecar.mjs",
    "tauri:dev": "pnpm --filter @gtmgrid/desktop tauri dev",
    "tauri:build": "pnpm --filter @gtmgrid/desktop tauri build",
    "db:generate": "pnpm --filter @gtmgrid/db db:generate",
    "db:migrate": "pnpm --filter @gtmgrid/db db:migrate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "turbo:typecheck": "turbo run typecheck",
    "turbo:lint": "turbo run lint",
    "turbo:test": "turbo run test",
    "typecheck": "tsc -b && pnpm --filter @gtmgrid/web typecheck && pnpm --filter @gtmgrid/desktop typecheck",
    "lint": "oxlint packages",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-app-version.mjs"
  },
  "dependencies": {
    "@gtmgrid/cloud": "workspace:*",
    "autumn-js": "1.2.27",
    "effect": "^3.21.3",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "oxlint": "^1.68.0",
    "tsx": "^4.19.2",
    "turbo": "^2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "kysely": "0.29.2"
    },
    "patchedDependencies": {
      "kysely@0.29.2": "patches/kysely@0.29.2.patch"
    }
  }
}
