{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTM Grid",
  "version": "0.9.8",
  "identifier": "app.gtmgrid.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @gtmgrid/desktop dev",
    "beforeBuildCommand": "pnpm --filter @gtmgrid/desktop build && node scripts/bundle-sidecar.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gtm grid",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "gtmgrid"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/badapplesdotdev/gtm-grid/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NUM0MDYxNzE0RjEyNTkKUldSWkVrOXhZVUJjbURxQ0lYaWVlVEFzM05EUWZyUlgrM1M4MDI1YUFBVWpMZmdWTDZUdnJ4N1EK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "sidecar/**/*"
    ]
  }
}
