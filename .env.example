# GTM Grid cloud tier — Postgres (Supabase) connection.
#
# Use the POOLED connection string from Supavisor in TRANSACTION mode.
# In the Supabase dashboard: Project Settings -> Database -> Connection string
# -> "Transaction" pooler. It uses port 6543 (NOT the direct 5432).
#
# The @gtmgrid/db client opens this with `prepare: false`, which is required for
# transaction-mode pooling (see packages/db/src/client.ts).
#
# `pnpm db:migrate` also reads this var to apply committed migrations.
# `pnpm db:generate` does NOT need it (migrations are generated offline).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Better Auth server (@gtmgrid/auth) — TRI-3244.
# ---------------------------------------------------------------------------
#
# Base URL of the deployment. Used as a trusted origin for OAuth redirects (the
# packaged-desktop `gtmgrid://` deep-link is always allowed alongside it).
SITE_URL=http://localhost:3000

# Transactional email (@gtmgrid/email, Resend). When AUTH_RESEND_KEY is UNSET,
# sendEmail no-ops and email verification + password reset are disabled (sign-up
# still works). RESEND_FROM overrides the default onboarding sender once a domain
# is verified, e.g. "GTM Grid <no-reply@gtmgrid.dev>".
AUTH_RESEND_KEY=
RESEND_FROM=

# GitHub OAuth (env-gated). The provider registers ONLY when BOTH are set.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth (env-gated). The provider registers ONLY when BOTH are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase project JWT secret (HS256). Used by @gtmgrid/auth to mint a
# Supabase-compatible realtime token carrying the signed-in user id (W3). Find it
# in the Supabase dashboard: Project Settings -> API -> JWT Secret.
SUPABASE_JWT_SECRET=

# Supabase Realtime broadcast (legacy W3 publisher transport). Superseded by the
# server-gated PartyKit provider below (TRI-3261); kept for the no-op fallback.
# When either is unset that publisher degrades to a no-op. Project Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The client (desktop/web) subscriber uses the project URL + anon key + the
# minted JWT (above) to authorize the Realtime connection (no RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-gated PartyKit realtime (apps/party, TRI-3261) — the live grid +
# presence provider that replaced Supabase Realtime.
# ---------------------------------------------------------------------------
#
# After each grid write the SERVER publishes the change to the grid party's
# onRequest endpoint (`${PARTY_URL}/parties/grid/${workspaceId}:${tableId}`) with
# `Authorization: Bearer PARTY_PUBLISH_SECRET`; the party broadcasts it to the
# connected (already-authorized) clients via @gtmgrid/services RealtimePublisher.
# When PARTY_URL or PARTY_PUBLISH_SECRET is unset, the publisher degrades to a
# no-op (writes still succeed; no live fan-out).
#
# PARTY_AUTH_SECRET    — HS256 secret. apps/web MINTS the workspace-scoped
#                        connection token with it (realtime.token); the deployed
#                        party VERIFIES it (onBeforeConnect). Must MATCH on both.
# PARTY_PUBLISH_SECRET — server-publish bearer. Shared between apps/web (sends)
#                        and the deployed party (checks). Must MATCH on both.
# PARTY_URL            — base URL of the party host. Local: http://127.0.0.1:1999.
#                        Prod: the `partykit deploy` host (see docs/cloud.md).
PARTY_AUTH_SECRET=
PARTY_PUBLISH_SECRET=
PARTY_URL=http://127.0.0.1:1999

# Webhook worker bearer secret. Shared between the apps/web `/api/worker/*`
# endpoints (which authenticate the caller via `@gtmgrid/services`
# `isAuthorizedWorker`) and BOTH callers of those endpoints: the Inngest webhook
# worker AND the desktop sidecar's cloud-column run path
# (packages/server/src/cloud-run.ts). Must be the same value on both sides.
WEBHOOK_WORKER_SECRET=

# ---------------------------------------------------------------------------
# Desktop cloud client — Postgres tier (tRPC + Better Auth).
# ---------------------------------------------------------------------------
#
# Base URL of the apps/web host that serves BOTH the tRPC API (`/api/trpc`) and
# Better Auth (`/api/auth`). This is the cloud gate for the desktop app:
#   - SET   → mount the tRPC + react-query + Better Auth providers (cloud on).
#   - UNSET → the app is local-only and issues zero cloud calls (the SQLite
#             sidecar engine path is unaffected).
# Vite exposes it to the desktop bundle as `import.meta.env.VITE_API_URL`.
VITE_API_URL=

# The desktop subscriber's Supabase project URL + anon (publishable) key for the
# W3 live-grid Realtime connection (the connection is authorized by the
# server-minted JWT; these only locate the project). When unset, the grid SEEDS
# via tRPC but receives no live patches. Vite exposes them as
# `import.meta.env.VITE_SUPABASE_URL` / `VITE_SUPABASE_ANON_KEY`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The desktop subscriber's PartyKit host URL for the live-grid connection
# (TRI-3261). The desktop opens a server-gated socket to
# `${VITE_PARTY_URL}/parties/grid/${workspaceId}:${tableId}` with the
# server-minted connection token. Local: http://127.0.0.1:1999. Prod: the
# `partykit deploy` host (must be the SAME host as PARTY_URL on apps/web). When
# unset, the grid SEEDS via tRPC but receives no live patches. Vite exposes it as
# `import.meta.env.VITE_PARTY_URL`.
VITE_PARTY_URL=http://127.0.0.1:1999

# Base URL of the inbound-webhook receiver (apps/web). The webhook setup form
# builds each table's endpoint as `${VITE_INNGEST_URL}/api/webhooks/:token`.
# Falls back to a documentation placeholder host when unset.
VITE_INNGEST_URL=

# AES-256-GCM master key for credential envelope encryption (32 bytes hex). Generate: openssl rand -hex 32
CREDENTIALS_MASTER_KEY=

# Inngest: set INNGEST_DEV=1 for local dev (no signing key needed; talks to the inngest dev server)
INNGEST_DEV=

# ---------------------------------------------------------------------------
# PostHog observability (product analytics, error tracking, logs, surveys).
# ---------------------------------------------------------------------------
#
# One PostHog project powers both surfaces. Web (apps/web) reads the
# NEXT_PUBLIC_* vars (build-inlined, client-visible) and proxies ingestion
# through `/ingest` (see apps/web/next.config.ts). When the token is UNSET,
# analytics + error tracking degrade to a no-op (the app still runs).
#   Project token: PostHog -> Project Settings -> Project API Key (phc_...).
#   Host: the EU/US ingest host, e.g. https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
#
# Desktop (packages/desktop, Vite). The native webview cannot use the web app's
# same-origin `/ingest` proxy, so it posts to the ABSOLUTE ingest host. Vite
# exposes these as `import.meta.env.VITE_POSTHOG_*`. Unset → analytics off.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
#
# Local sidecar (packages/server, Node) — error tracking + structured logs. The
# Tauri shell passes these into the spawned sidecar's env. Unset → stderr only.
GTMGRID_POSTHOG_KEY=
GTMGRID_POSTHOG_HOST=https://eu.i.posthog.com
#
# PartyKit realtime (apps/party, Cloudflare Workers) — realtime connection
# telemetry via fire-and-forget capture. Set in the party's deploy env. Unset → off.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ---------------------------------------------------------------------------
# Cloud billing (Autumn / Stripe) — @gtmgrid/services.
# ---------------------------------------------------------------------------
# Server-side Autumn secret used to read plan state + meter cloud-action usage.
# When unset, entitlement checks fail closed (cloud features gated off).
AUTUMN_SECRET_KEY=

# Shared bearer for the billing webhook (apps/web `/api/billing/webhook`). Configure
# Autumn (or a Stripe→relay) to POST subscription events here with
# `Authorization: Bearer <this>` so out-of-app cancellations revoke cloud access
# immediately. Fail-closed: when UNSET the webhook rejects every request (401).
AUTUMN_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI providers (engine `ai.generate` column + env fallback) — optional.
# Any that are set become available; unset providers are simply unavailable.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Hermes agent gateway (optional) — base URL + key for the Hermes AI provider.
HERMES_BASE_URL=
HERMES_API_KEY=

# Base URL used to build workspace invite links (falls back to SITE_URL).
INVITE_BASE_URL=

# Set to "true" to require verified email before sign-in (default: off).
AUTH_REQUIRE_EMAIL_VERIFICATION=
