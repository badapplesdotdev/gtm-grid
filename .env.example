# GTM Grid cloud tier — Postgres (Supabase) connection.
#
# Use the POOLED connection string from Supavisor in TRANSACTION mode.
# In the Supabase dashboard: Project Settings -> Database -> Connection string
# -> "Transaction" pooler. It uses port 6543 (NOT the direct 5432).
#
# The @gtmgrid/db client opens this with `prepare: false`, which is required for
# transaction-mode pooling (see packages/db/src/client.ts).
#
# `pnpm db:migrate` also reads this var to apply committed migrations.
# `pnpm db:generate` does NOT need it (migrations are generated offline).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
