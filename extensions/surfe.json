    {
      "id": "startPeopleEnrichment",
      "label": "Enrich People (start)",
      "category": "Enrich people",
      "verb": "POST",
      "path": "/v2/people/enrich",
      "description": "Start an asynchronous enrichment job for up to 10,000 people. Returns enrichmentID and enrichmentCallbackURL; use the matching get method or a webhook for results. Official docs: https://developers.surfe.com/public-015-create-people-bulk-enrichment",
      "credits": 1,
      "input": {
        "type": "object",
        "required": [
          "include",
          "people"
        ],
        "properties": {
          "enrichmentOptions": {
            "type": "object",
            "properties": {
              "acceptedEmailType": {
                "type": "string",
                "enum": [
                  "professional",
                  "personal"
                ]
              },
              "skipMobileEnrichmentIfNoEmailFound": {
                "type": "boolean"
              }
            }
          },
          "include": {
            "type": "object",
            "description": "Select at least one enrichment field.",
            "properties": {
              "email": {
                "type": "boolean"
              },
              "jobHistory": {
                "type": "boolean"
              },
              "linkedInUrl": {
                "type": "boolean"
              },
              "mobile": {
                "type": "boolean"
              }
            }
          },
          "notificationOptions": {
            "type": "object",
            "properties": {
              "webhookUrl": {
                "type": "string",
                "format": "uri",
                "description": "HTTPS callback for completed enrichment results."
              }
            }
          },
          "people": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "properties": {
                "companyDomain": {
                  "type": "string"
                },
                "companyName": {
                  "type": "string"
                },
                "externalID": {
                  "type": "string"
                },
                "firstName": {
                  "type": "string"
                },
                "lastName": {
                  "type": "string"
                },
                "linkedinUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "getPeopleEnrichment",
      "label": "Enrich People (get)",
      "category": "Enrich people",
      "verb": "GET",
      "path": "/v2/people/enrich/{id}",
      "description": "Get progress and completed results for an asynchronous people enrichment. Poll about once per second only when webhooks are unavailable. Official docs: https://developers.surfe.com/public-016-get-bulk-enrichment",
      "credits": 0,
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Enrichment ID returned by Enrich People (start)."
          }
        }
      }
    },
    {
      "id": "findPeopleByEmail",
      "label": "Enrich People by Email (start)",
      "category": "Enrich people",
      "verb": "POST",
      "path": "/v2/people/find-by-email",
      "description": "Start asynchronous person lookup by email. Finding a LinkedIn URL costs 10 Search credits; retrieve results with Get People Enrichment or a webhook. Official docs: https://developers.surfe.com/public-018-v2-people-find-by-email-post",
      "credits": 10,
      "input": {
        "type": "object",
        "required": [
          "people"
        ],
        "properties": {
          "notificationOptions": {
            "type": "object",
            "properties": {
              "webhookUrl": {
                "type": "string",
                "format": "uri",
                "description": "HTTPS callback for completed enrichment results."
              }
            }
          },
          "people": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "email"
              ],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "externalID": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
